# GEMINI_API_KEY: Required for Gemini AI API calls if used.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server-side Administrator password for /admin dashboard authentication
ADMIN_PASSWORD="change-this-admin-password"

# Secret used to sign HttpOnly administrator session cookies
SESSION_SECRET="change-this-random-session-secret"
